{
  "name": "dsh-session-manager",
  "version": "0.4.1",
  "description": "Full session management for the DSH web UI: delete with a recoverable trash (restore/purge), force delete for foreign session ids, restore archived sessions, activity stats, continue/pause, fork, unread markers, log folders, workspace grouping, and a global context compaction threshold. Native DSH dialogs, no harness changes.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "market-submission",
    "assets"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "pack:release": "npm pack --ignore-scripts && mv dsh-session-manager-*.tgz dsh-session-manager.tgz"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cosmokit": "^1.8.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-storage": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-storage-domain": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-atomic-write": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "zod": "^4.4.3",
    "js-yaml": "^4.3.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "license": "MIT"
}
